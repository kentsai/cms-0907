<?xml version="1.0" encoding="utf-8"?>
<!--
  web.config for the Angular site (IIS site "CMS", physical path C:\VHome\CMS\NG).

  deploy.ps1 stamps {{API_ORIGIN}} and writes the result into dist\CMS.NG\browser\web.config
  before copying. Same idea as nginx.conf.template in the azure-deploy kit: the API's address
  is CONFIGURATION, not something baked into the Angular bundle.

  Requires on the IIS server: URL Rewrite module + Application Request Routing (ARR),
  with the server-level proxy ENABLED. setup-iis.ps1 does all three.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- 1. Reverse-proxy /api/* to the CMS.API site.
             The browser only ever talks to this origin, so environment.ts can keep
             apiBaseUrl: '/api' and no CORS policy is needed in the API. -->
        <rule name="CMS API proxy" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="{{API_ORIGIN}}/api/{R:1}" logRewrittenUrl="true" />
        </rule>

        <!-- 2. Angular deep links: anything that is not a real file or directory falls
             back to index.html. The ^/api exclusion is belt-and-braces — rule 1 already
             stops processing — but without it a misordered edit would silently swallow
             every API call and return the SPA shell instead of JSON. -->
        <rule name="Angular routes" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/api" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>

      <!-- HSTS, but only on responses that actually went over HTTPS: browsers ignore the header on plain
           HTTP, and a static customHeader cannot be conditional. Inert until an HTTPS binding exists. -->
      <outboundRules>
        <rule name="HSTS over HTTPS only" enabled="true">
          <match serverVariable="RESPONSE_Strict_Transport_Security" pattern=".*" />
          <conditions>
            <add input="{HTTPS}" pattern="on" ignoreCase="true" />
          </conditions>
          <action type="Rewrite" value="max-age=31536000" />
        </rule>
      </outboundRules>
    </rewrite>

    <!-- Browser security headers for the SPA. The API sets its own in-process (SecurityHeadersMiddleware);
         these are for the HTML, JS and CSS that IIS serves from this folder.

         Content-Security-Policy is tuned to what the production bundle actually does:
           script-src 'self'            — index.html has no inline script (angular.json sets
                                          optimization.styles.inlineCritical=false, because the critical-CSS
                                          inliner adds an inline onload= handler that this would block);
           style-src 'self' 'unsafe-inline' — Angular's emulated encapsulation and PrimeNG's styled theme inject
                                          <style> elements at runtime; a nonce needs a server that renders
                                          index.html per request, which a static IIS site is not;
           img-src 'self' data:         — the QR code renders to a <canvas>; data: is a cheap allowance for any
                                          theme asset that uses it;
           connect-src 'self'           — the API is same-origin behind the /api proxy rule above;
           frame-ancestors 'none'       — nothing embeds this app (X-Frame-Options below is the legacy twin).
         Proxied /api responses keep the API's own headers; customHeaders only applies to what IIS serves. -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=(), payment=(), usb=()" />
      </customHeaders>
    </httpProtocol>

    <!-- No "Server: Microsoft-IIS/10.0" advertisement (IIS 10 1709+). -->
    <security>
      <requestFiltering removeServerHeader="true" />
    </security>

    <!-- Angular emits content-hashed filenames (outputHashing: all), so the bundles are
         safe to cache forever. -->
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
    </staticContent>
  </system.webServer>

  <!-- ...but index.html is NOT hashed. Cache it and a redeploy keeps serving the old
       bundle names until the browser gives up. This is the #1 "I deployed but nothing
       changed" bug on IIS. -->
  <location path="index.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
